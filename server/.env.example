# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Local example: mongodb://localhost:27017/fake_job_detection
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fake_job_detection?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fake_job_detection

# Google Gemini API Key
# 1. Visit https://aistudio.google.com/
# 2. Sign in with your Google account
# 3. Click "Get API key" -> "Create API key"
# 4. Paste your key below (keep this secret, never commit this file)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model
# Currently supported Google AI Studio models:
# - gemini-1.5-flash (recommended: fast, cost-effective, high reasoning)
# - gemini-1.5-pro (higher reasoning capacity for complex text)
# - gemini-2.0-flash (newest generation preview)
GEMINI_MODEL=gemini-1.5-flash
# (GEMINI_CHAT_MODEL is also supported as an alias)
