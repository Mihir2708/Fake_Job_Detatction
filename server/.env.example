# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI
# Local:  mongodb://localhost:27017/fake_job_detection
# Atlas:  mongodb+srv://<username>:<password>@cluster0.mongodb.net/fake_job_detection?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fake_job_detection

# ─────────────────────────────────────────────────────────────────────────────
# AI — Google Gemini (REQUIRED for AI analysis)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Visit https://aistudio.google.com/
# 2. Click "Get API key" → "Create API key"
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (gemini-1.5-flash recommended for speed + cost)
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# Web Search — Tavily Search API (PRIMARY — recommended)
# Enables: company domain web search, scam report search
# Documentation: https://docs.tavily.com/
# ─────────────────────────────────────────────────────────────────────────────
# 1. Visit https://tavily.com/ and create a free account
# 2. Copy your API key from the dashboard
TAVILY_API_KEY=your_tavily_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Web Search — Google Custom Search API (FALLBACK / ALTERNATIVE)
# Enables: company web search, scam report search
# ─────────────────────────────────────────────────────────────────────────────
# 1. Enable the Custom Search JSON API at https://console.cloud.google.com
# 2. Create a Programmable Search Engine at https://programmablesearchengine.google.com
# 3. Set it to "Search the entire web"
# If TAVILY_API_KEY is provided, it is used as the primary search provider.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_custom_search_engine_id_here

# ─────────────────────────────────────────────────────────────────────────────
# URL Safety — Google Safe Browsing API (OPTIONAL)
# Enables: malware/phishing check on application URLs
# ─────────────────────────────────────────────────────────────────────────────
# 1. Enable Safe Browsing API at https://console.cloud.google.com
# 2. Create an API key restricted to Safe Browsing API
# Without this key, URL safe-browsing reports SOURCE_UNAVAILABLE.
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
