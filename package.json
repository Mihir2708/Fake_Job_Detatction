{
  "name": "fake-job-detection",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Fake Job Detection application using Next.js, Express.js, MongoDB, and Google Gemini API",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:start": "npm --prefix client start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.453.0",
    "mongoose": "^8.7.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "keywords": [
    "fake-job-detection",
    "express",
    "nextjs",
    "gemini-api",
    "mongodb",
    "javascript"
  ],
  "author": "",
  "license": "ISC"
}
