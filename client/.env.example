# ==============================================================================
# Client Environment Variables (Next.js)
# ==============================================================================

# Option 1: Direct Backend API URL (Client-Side Requests)
# In local development: http://localhost:5000/api
# On Vercel: Set this in Vercel Project Settings > Environment Variables
# Example: https://fake-job-detection-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Option 2: Automatic Next.js Reverse Proxy (Alternative)
# If you set BACKEND_URL, Next.js rewrites all /api/* calls to this server,
# completely eliminating CORS issues.
# Example: https://fake-job-detection-api.onrender.com
# BACKEND_URL=https://your-backend-host.com
